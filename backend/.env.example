DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auditbite
SUPABASE_JWT_SECRET=            # Supabase project JWT secret (HS256)
ANTHROPIC_API_KEY=              # required for the worker to process invoices
AUDITBITE_MODEL=claude-sonnet-5-5
RESEND_API_KEY=                 # unset => emails are only recorded locally (OutboxSender)
AUDITBITE_FROM_EMAIL=claims@yourdomain.example
STORAGE_DIR=./storage
FILE_SIGN_SECRET=               # long random string for signed file URLs
INBOUND_WEBHOOK_SECRET=         # shared secret for /webhooks/inbound-email
ALLOWED_ORIGINS=http://localhost:3000
